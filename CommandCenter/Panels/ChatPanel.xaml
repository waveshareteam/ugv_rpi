<UserControl x:Class="CommandCenter.Panels.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource PanelCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="💬 LANCE — AI COMMAND BRAIN (local Ollama on the robot)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Lance can drive, turn lights on/off, report battery &amp; lidar, take photos, and toggle avoidance." Foreground="#FF78909C" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <Border DockPanel.Dock="Bottom" Background="#FF1B1E23" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                    <DockPanel>
                        <Button x:Name="SendBtn" Content="Send ▶" Style="{StaticResource OpButton}" DockPanel.Dock="Right" Click="OnSend" IsEnabled="False"/>
                        <TextBox x:Name="InputBox" Background="#FF23262B" Foreground="White" BorderBrush="#FF37474F"
                                 FontSize="13" Padding="8,6" VerticalContentAlignment="Center"
                                 KeyDown="OnInputKey" LostFocus="OnInputFocus" GotFocus="OnInputFocus"/>
                    </DockPanel>
                </Border>
                <Border Background="#FF0D0F12" CornerRadius="6" ClipToBounds="True" Margin="0,8,0,0">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl x:Name="Log">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding Color}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFE0E6EA" FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>