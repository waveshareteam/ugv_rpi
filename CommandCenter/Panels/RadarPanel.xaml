<UserControl x:Class="CommandCenter.Panels.RadarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelCard}" Grid.Column="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="LIDAR RADAR — 0° = forward" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="AvoidBtn" Content="Disable Avoidance" Style="{StaticResource OpButton}" HorizontalAlignment="Right" Click="OnAvoidToggle"/>
                </DockPanel>
                <Border Background="#FF0D0F12" CornerRadius="6" ClipToBounds="True">
                    <Canvas x:Name="RadarCanvas"/>
                </Border>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border Style="{StaticResource PanelCard}" DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="AvoidState" Style="{StaticResource HudValue}" Text="—"/>
                    <TextBlock x:Name="HwState" Style="{StaticResource HudText}" Text="—"/>
                    <TextBlock x:Name="ScanInfo" Style="{StaticResource HudText}" Text="—" Margin="0,8,0,0"/>
                    <TextBlock x:Name="NearestInfo" Style="{StaticResource HudValue}" Text="—"/>
                    <TextBlock Style="{StaticResource HudText}" Text="Display range (m)" Margin="0,10,0,2"/>
                    <Slider x:Name="RangeSlider" Minimum="4" Maximum="12" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource HudText}" TextWrapping="Wrap"
                               Text="Red dots are obstacles within range. The dashed wedge is the avoidance keep-out zone. While you drive manually the robot pauses avoidance and resumes automatically a few seconds after you stop."/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
