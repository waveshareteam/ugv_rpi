<UserControl x:Class="CommandCenter.Panels.DrivePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- video + control bar -->
        <Border Style="{StaticResource PanelCard}" Grid.Column="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LIVE VIDEO — WASD drives, arrows nudge the camera gimbal, Q/E spin, Space stops" Style="{StaticResource SectionTitle}"/>
                <Border DockPanel.Dock="Bottom" Background="#FF1B1E23" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SPEED" Foreground="#FF78909C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SpeedSlider" Width="200" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="OnSpeedChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SpeedLabel" Text="100%" Foreground="#FF4FF5C0" Width="48" VerticalAlignment="Center"/>
                        <Button x:Name="LightsBtn" Content="💡 Lights" Style="{StaticResource OpButton}" Click="OnLights"/>
                        <Button x:Name="AutoBtn" Content="🐢 Auto-Drive OFF" Style="{StaticResource OpButton}" Click="OnAutoDrive"/>
                        <Button Content="📸 Snapshot" Style="{StaticResource OpButton}" Click="OnSnapshot"/>
                    </StackPanel>
                </Border>
                <Border Background="Black" CornerRadius="6" ClipToBounds="True">
                    <Image x:Name="VideoImage" Stretch="Uniform"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- right column: telemetry + D-pad + CV -->
        <DockPanel Grid.Column="1">
            <Border Style="{StaticResource PanelCard}" DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Text="TELEMETRY" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource HudText}" Text="CPU"/>
                            <TextBlock Style="{StaticResource HudValue}" Text="{Binding CpuText}"/>
                            <TextBlock Style="{StaticResource HudText}" Text="RAM"/>
                            <TextBlock Style="{StaticResource HudValue}" Text="{Binding RamText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource HudText}" Text="BATTERY / TEMP"/>
                            <TextBlock Style="{StaticResource HudValue}" Text="{Binding VoltText}"/>
                            <TextBlock Style="{StaticResource HudText}" Text="WIFI"/>
                            <TextBlock Style="{StaticResource HudValue}" Text="{Binding RssiText}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" DockPanel.Dock="Top">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="DRIVE" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <Grid Width="186" Height="186" HorizontalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <RepeatButton Grid.Row="0" Grid.Column="1" Style="{StaticResource OpRepeatButton}" Content="▲" FontSize="20" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="fwd"/>
                        <RepeatButton Grid.Row="0" Grid.Column="0" Style="{StaticResource OpRepeatButton}" Content="↖" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="fwd_left"/>
                        <RepeatButton Grid.Row="0" Grid.Column="2" Style="{StaticResource OpRepeatButton}" Content="↗" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="fwd_right"/>
                        <RepeatButton Grid.Row="1" Grid.Column="0" Style="{StaticResource OpRepeatButton}" Content="◀" FontSize="20" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="fwd_left"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="■" FontSize="16" Style="{StaticResource OpButton}" Click="OnStop"/>
                        <RepeatButton Grid.Row="1" Grid.Column="2" Style="{StaticResource OpRepeatButton}" Content="▶" FontSize="20" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="fwd_right"/>
                        <RepeatButton Grid.Row="2" Grid.Column="0" Style="{StaticResource OpRepeatButton}" Content="↙" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="back_left"/>
                        <RepeatButton Grid.Row="2" Grid.Column="1" Style="{StaticResource OpRepeatButton}" Content="▼" FontSize="20" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="back"/>
                        <RepeatButton Grid.Row="2" Grid.Column="2" Style="{StaticResource OpRepeatButton}" Content="↘" Click="OnDirHold" MouseUp="OnDirRelease" MouseLeave="OnDirRelease" Tag="back_right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Text="CV / DETECTION" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button Content="None" Style="{StaticResource OpButton}" Click="OnCv" Tag="none"/>
                        <Button Content="Face" Style="{StaticResource OpButton}" Click="OnCv" Tag="face"/>
                        <Button Content="Objects" Style="{StaticResource OpButton}" Click="OnCv" Tag="objs"/>
                        <Button Content="Color" Style="{StaticResource OpButton}" Click="OnCv" Tag="color"/>
                        <Button Content="Motion" Style="{StaticResource OpButton}" Click="OnCv" Tag="motion"/>
                        <Button Content="Auto-Track" Style="{StaticResource OpButton}" Click="OnCv" Tag="track"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
